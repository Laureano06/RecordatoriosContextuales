# Copiá este archivo como keystore.properties (no se sube al repositorio).
# Generá la clave una sola vez, fuera del proyecto:
#   keytool -genkeypair -v -keystore C:/ruta/segura/recordatorios-release.jks -alias recordatorios #           -keyalg RSA -keysize 2048 -validity 10000
storeFile=C:/ruta/segura/recordatorios-release.jks
storePassword=CAMBIAR
keyAlias=recordatorios
keyPassword=CAMBIAR
